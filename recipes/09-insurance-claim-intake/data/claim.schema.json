{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "First notice of loss claim record",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "status", "created_at", "caller", "policy_number", "incident_date",
               "location", "description", "injuries", "conference", "callback"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^CL-[0-9]{4,}$"},
    "status": {"enum": ["awaiting_adjuster", "bridged", "callback_promised"]},
    "created_at": {"type": "string"},
    "caller": {"type": "string"},
    "policy_number": {"type": "string", "minLength": 1},
    "incident_date": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "injuries": {"type": "boolean"},
    "conference": {"type": "string"},
    "callback": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["number", "preferred_time", "promised_at"],
      "properties": {
        "number": {"type": "string"},
        "preferred_time": {"type": "string", "minLength": 1},
        "promised_at": {"type": "string"}
      }
    }
  }
}

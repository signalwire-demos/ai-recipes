SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE=example.signalwire.com
SWML_BASIC_AUTH_USER=recipe
SWML_BASIC_AUTH_PASSWORD=change-me
PUBLIC_URL=https://xxxx.ngrok.app
PORT=3000
# recipe-specific keys below this line
# Called numbers per tenant, E.164 (tenants/*.yaml reference these). Demo pool: TENANT_1..3 in NUMBERS.md.
# Blank is fine: route with ?tenant=<id> in the webhook URL instead.
TENANT_1=
TENANT_2=
TENANT_3=
# Transfer targets, E.164. Put a real phone here for a live transfer test. Blank = transfer refused.
DENTAL_FRONT_DESK=
HVAC_ON_CALL=
LAW_INTAKE_DESK=

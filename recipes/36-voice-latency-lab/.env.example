SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE=example.signalwire.com
SWML_BASIC_AUTH_USER=recipe
SWML_BASIC_AUTH_PASSWORD=change-me
PUBLIC_URL=https://xxxx.ngrok.app
PORT=3000
# recipe-specific keys below this line
# run_lab.py places calls with scripts/smoke_call.py: TEST_INBOUND is the agent's number,
# TEST_CALLER is the scripted caller (both roles are in NUMBERS.md / the root .env).
# Set them here only if your monorepo-root .env doesn't have them (a blank line here would hide it):
# TEST_INBOUND=+1...
# TEST_CALLER=+1...

SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE=example.signalwire.com
SWML_BASIC_AUTH_USER=recipe
SWML_BASIC_AUTH_PASSWORD=change-me
PUBLIC_URL=https://xxxx.ngrok.app
PORT=3000
# recipe-specific keys below this line
# The human support phone (defaults to HUMAN_LEG from the monorepo .env). Use a real phone for a live test.
HUMAN_NUMBER=
# Caller ID for the human transfer and the return call (defaults to OUTBOUND_2)
FROM_NUMBER=
# rota (default) | free | busy
AVAILABILITY=rota
WORKER_INTERVAL=30

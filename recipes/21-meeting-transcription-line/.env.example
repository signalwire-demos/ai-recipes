SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE=example.signalwire.com
SWML_BASIC_AUTH_USER=recipe
# Replace change-me: the app refuses to start with it. Use a long random value.
SWML_BASIC_AUTH_PASSWORD=change-me
PUBLIC_URL=https://xxxx.ngrok.app
PORT=3000
# recipe-specific keys below this line
# Where the platform POSTs transcript events. Blank = PUBLIC_URL/transcript with the basic auth above.
TRANSCRIPT_WEBHOOK_URL=
# Read-only login for transcript viewers (one call at a time, never writes).
# Blank = only the SWML basic auth above can read transcripts.
VIEWER_USER=
VIEWER_PASSWORD=
# Optional: Dashboard > API > Signing Key. When set, POST /transcript checks X-SignalWire-Signature.
SIGNALWIRE_SIGNING_KEY=
# Optional: connect the caller to this number (both legs transcribed). Blank = dictation mode.
MEETING_BRIDGE_NUMBER=
MEETING_BRIDGE_FROM=

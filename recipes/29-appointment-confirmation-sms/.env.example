SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE=example.signalwire.com
SWML_BASIC_AUTH_USER=recipe
# Replace change-me: the app refuses to start with it. Use a long random value.
SWML_BASIC_AUTH_PASSWORD=change-me
PUBLIC_URL=https://xxxx.ngrok.app
PORT=3000
# recipe-specific keys below this line
SMS_1=
OUTBOUND_1=
# Required: Dashboard > API > Signing Key. /sms refuses every text (403) without it, and
# /sms and the agent routes check X-SignalWire-Signature with it.
SIGNALWIRE_SIGNING_KEY=
# Optional: minutes between call backs for one booking, however many CHANGE texts arrive (default 10)
DIAL_BACK_COOLDOWN_MINUTES=

SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE=example.signalwire.com
SWML_BASIC_AUTH_USER=recipe
SWML_BASIC_AUTH_PASSWORD=change-me
PUBLIC_URL=https://xxxx.ngrok.app
PORT=3000
# recipe-specific keys below this line
# Optional: the publishable key the widget carries (default: a random one per process)
SIGNALWIRE_CHAT_GATEWAY_KEY=
# Optional: HMAC secret for chat handles; set it so handles survive a restart
SIGNALWIRE_CHAT_GATEWAY_SECRET=
# Optional: comma-separated origins of other sites that embed the widget
CHAT_ALLOWED_ORIGINS=
# Optional: override the SWML URL the AI Chat service fetches (default: PUBLIC_URL with basic auth)
CHAT_CONFIG_URL=

SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE=example.signalwire.com
SWML_BASIC_AUTH_USER=recipe
SWML_BASIC_AUTH_PASSWORD=change-me
PUBLIC_URL=https://xxxx.ngrok.app
PORT=3000
# recipe-specific keys below this line
# Required: the voice agent's token for the calendar MCP server. By default app.py serves the
# reference calendar itself at PUBLIC_URL + /mcp-calendar, so the one tunnel covers both.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
# app.py refuses to start while it is blank (or the old change-me-calendar-token placeholder).
MCP_TOKEN=
# Optional: use an external calendar MCP server instead (public HTTPS; the platform calls it).
# Setting MCP_URL switches the built-in calendar off unless SERVE_REFERENCE_CALENDAR=true.
# MCP_URL=https://calendar.example.com/mcp
# Reference server only: a second token whose scope also allows cancel_meeting.
MCP_ADMIN_TOKEN=
# Optional: key for the signed caller ID in each call's MCP headers. Random per process if
# blank, which is fine for the built-in calendar. Required (same value in both) when the
# reference server runs on its own with `python mcp_calendar.py`.
MCP_CALLER_KEY=

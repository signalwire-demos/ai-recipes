SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE=example.signalwire.com
SWML_BASIC_AUTH_USER=recipe
SWML_BASIC_AUTH_PASSWORD=change-me
PUBLIC_URL=https://xxxx.ngrok.app
PORT=3000
# recipe-specific keys below this line
# The calendar MCP server. SignalWire's platform calls it, so on a live call this must be
# a public HTTPS URL (e.g. a second tunnel to port 3001 for the reference server).
MCP_URL=https://yyyy.ngrok.app/mcp
MCP_TOKEN=change-me-calendar-token
# Reference server only: a second token whose scope also allows cancel_meeting.
MCP_ADMIN_TOKEN=

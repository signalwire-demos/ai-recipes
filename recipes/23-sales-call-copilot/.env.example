SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE=example.signalwire.com
SWML_BASIC_AUTH_USER=recipe
# Replace change-me: the app refuses to start with it. Use a long random value.
SWML_BASIC_AUTH_PASSWORD=change-me
PUBLIC_URL=https://xxxx.ngrok.app
PORT=3000
# recipe-specific keys below this line
# The sales rep's phone; the inbound call is bridged here (demo pool: HUMAN_LEG_2)
REP_NUMBER=
# Caller ID for the bridged leg (demo pool: OUTBOUND_2)
FROM_NUMBER=
# Optional sidecar model; blank = platform default
SIDECAR_MODEL=
# The rep page's login (/rep/). Must differ from the SWML basic auth; blank = rep page locked
REP_USER=rep
REP_PASSWORD=
